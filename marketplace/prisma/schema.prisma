generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  passwordHash  String
  role          String     @default("buyer") // buyer | creator | admin
  avatar        String?
  bio           String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  templates     Template[]
  purchases     Purchase[]
  reviews       Review[]
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  icon      String?
  templates Template[]
}

model Template {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  description String
  longDesc    String?
  price       Float
  salePrice   Float?
  format      String     // e.g., "figma", "notion", "canva", "psd", "docx"
  previewUrl  String?
  fileUrl     String?
  downloads   Int        @default(0)
  featured    Boolean    @default(false)
  published   Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  creator     User       @relation(fields: [creatorId], references: [id])
  creatorId   String
  category    Category   @relation(fields: [categoryId], references: [id])
  categoryId  String
  purchases   Purchase[]
  reviews     Review[]
}

model Purchase {
  id              String   @id @default(cuid())
  amount          Float
  stripePaymentId String?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id])
  userId          String
  template        Template @relation(fields: [templateId], references: [id])
  templateId      String
}

model Review {
  id         String   @id @default(cuid())
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  template   Template @relation(fields: [templateId], references: [id])
  templateId String
}
